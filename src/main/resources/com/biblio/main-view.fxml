                  </AnchorPane>
              </content>
            </Tab>
            <Tab text="Книга">
               <content>
                  <GridPane prefHeight="922.0" prefWidth="458.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="181.0" minWidth="10.0" prefWidth="158.0" />
