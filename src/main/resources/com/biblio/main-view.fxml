<BorderPane prefHeight="1020.0" prefWidth="1300.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.biblio.controller.BiblioController">
   <top>
      <Pane prefHeight="61.0" prefWidth="1300.0" style="-fx-background-color: #edf6fc; -fx-background-radius: 10;" BorderPane.alignment="CENTER">
         <children>
            <ImageView fx:id="logoImageView" fitHeight="60.0" fitWidth="70.0" layoutX="4.0" layoutY="3.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@logo.jpg" />
               </image>
            </ImageView>
            <Pane layoutX="72.0" layoutY="3.0" prefHeight="55.0" prefWidth="137.0" style="-fx-border-color: #1e4f9b; -fx-border-radius: 10;">
               <children>
                  <Text fill="#1e4f9b" layoutX="22.0" layoutY="39.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Biblio">
                     <font>
                        <Font name="Times New Roman Bold" size="36.0" />
                     </font>
                  </Text>
               </children>
            </Pane>
            <TextField layoutX="741.0" layoutY="18.0" prefHeight="25.0" prefWidth="309.0" />
            <Text fill="#1e4f9b" layoutX="516.0" layoutY="40.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Поиск по литературе">
               <font>
                  <Font name="Times New Roman" size="24.0" />
               </font>
            </Text>
            <Button layoutX="1063.0" layoutY="18.0" mnemonicParsing="false" onAction="#onClickedSearch">
               <graphic>
                  <ImageView fitHeight="25" fitWidth="25">
                     <image>
                        <Image url="@search.jpg" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
            <Button accessibleRole="IMAGE_VIEW" contentDisplay="GRAPHIC_ONLY" layoutX="1223.0" layoutY="9.0" mnemonicParsing="false" prefHeight="24.0" prefWidth="20.0" text="Button">
               <graphic>
                  <ImageView accessibleRole="BUTTON" fitHeight="39.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@github.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
         </children></Pane>
   </top>
   <left>
